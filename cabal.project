-- Custom repository for cardano haskell packages, see
-- https://github.com/IntersectMBO/cardano-haskell-packages
-- for more information.
--
-- [NOTE] The "/" in the end of the URL is mandatory, or else we get a 404 NOT FOUND
repository cardano-haskell-packages
  url: https://chap.intersectmbo.org/
  secure: True
  root-keys:
    3e0cce471cf09815f930210f7827266fd09045445d65923e6d0238a6cd15126f
    443abb7fb497a134c343faf52f0b659bd7999bc06b7f63fa76dc99d631f9bea1
    a86a1f6ce86c449c46666bda44268677abf29b5b2d2eb5ec7af903ec2f117a82
    bcec67e8e99cabfa7764d75ad9b158d72bfacf70ca1d0ec8bc6b4406d1bf8413
    c00aae8461a256275598500ea0e187588c35a5d5d7454fb57eac18d9edb86a56
    d4a35cd3121aa00d18544bb0ac01c3e1691d618f462c46129271bccf39f7e8ee

index-state:
  , hackage.haskell.org 2026-05-31T00:00:00Z
  , cardano-haskell-packages 2026-05-31T00:00:00Z

with-compiler: ghc-9.6.6

constraints:
  -- Pinned to what upstream Plutarch 1.14.0 requires (it pins plutus-core
  -- ==1.65.0.0 exactly, so this is not a floor but the exact version).
  , plutus-core == 1.65.0.0
  , plutus-ledger-api == 1.65.0.0
  , plutus-tx == 1.65.0.0

allow-newer:
  -- These constraints are taken from Plutarch.
  -- https://github.com/phadej/vec/issues/121
  ral:QuickCheck,
  fin:QuickCheck,
  bin:QuickCheck,

packages:
    src/plutarch-onchain-lib

-- Upstream Plutarch c3b47719 (1.14.0) with ONE line removed: a stray
-- {-# LANGUAGE TypeAbstractions #-} in Plutarch/Internal/Parse.hs. That
-- extension is GHC 9.8+, but upstream's own plutarch.cabal declares
-- `tested-with: GHC ==9.6.4` and nothing in the file uses type-abstraction
-- syntax -- every `@a` in it is an ordinary type APPLICATION. Consumed from a
-- local checkout while we confirm that; upstreaming the deletion is the fix.
packages:
    /home/gumbo/iohk/plutarch-1.14-patched
    /home/gumbo/iohk/plutarch-1.14-patched/plutarch-ledger-api
    /home/gumbo/iohk/plutarch-1.14-patched/plutarch-orphanage
    /home/gumbo/iohk/plutarch-1.14-patched/plutarch-testlib
